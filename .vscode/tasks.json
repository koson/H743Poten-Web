{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "H743Poten: Start Development Server",
			"type": "shell",
			"command": "ssh",
			"args": ["ben@192.168.9.75", "cd /home/ben/h743poten-web && dotnet run --project STM32CVWebAPI.csproj --urls 'http://0.0.0.0:5000'"],
			"group": "build",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Stop Development Server",
			"type": "shell",
			"command": "ssh",
			"args": ["ben@192.168.9.75", "pkill -f 'dotnet.*STM32CVWebAPI'"],
			"group": "build",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Server Status",
			"type": "shell",
			"command": "ssh",
			"args": ["ben@192.168.9.75", "curl -s http://localhost:5000/api/stm32/status || echo 'Server not running'"],
			"group": "test",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Show Logs",
			"type": "shell",
			"command": "ssh",
			"args": ["ben@192.168.9.75", "journalctl -f -u dotnet || tail -f ~/h743poten-web/logs/*.log"],
			"group": "test",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Start Flask App (Production)",
			"type": "shell",
			"command": "bash",
			"args": ["-c", "source poten-env/bin/activate && python main.py"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Start Flask App (Development)",
			"type": "shell",
			"command": "ssh",
			"args": ["ben@192.168.9.75", "cd /home/ben/h743poten-web && dotnet run --project STM32CVWebAPI.csproj --urls 'http://0.0.0.0:5000'"],
			"group": "build",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Install Dependencies",
			"type": "shell",
			"command": "bash",
			"args": ["-c", "source poten-env/bin/activate && pip install -r requirements.txt"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Install Pi Dependencies",
			"type": "shell",
			"command": "bash",
			"args": ["-c", "source poten-env/bin/activate && pip install -r requirements-pi.txt"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Create Virtual Environment",
			"type": "shell",
			"command": "python3",
			"args": ["-m", "venv", "poten-env"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Check Hardware",
			"type": "shell",
			"command": "ssh",
			"args": ["ben@192.168.9.75", "\"ls -la /dev/ttyUSB* /dev/ttyACM* 2>/dev/null || echo 'No USB devices found'; whoami; groups\""],
			"group": "test",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		},
		{
			"label": "H743Poten: Test SCPI Commands",
			"type": "shell",
			"command": "ssh",
			"args": ["ben@192.168.9.75", "cd /home/ben/h743poten-web && python3 test_cv_api_client.py"],
			"group": "test",
			"presentation": { 
				"echo": true, 
				"reveal": "always", 
				"focus": false, 
				"panel": "shared" 
			},
			"problemMatcher": []
		}
	]
}